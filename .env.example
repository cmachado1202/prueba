# Copiar a un gestor seguro de secretos. NO completar ni commitear este archivo con valores reales.
# En n8n se recomienda crear Credentials y referenciarlas desde los nodos.

# NVIDIA / Document AI + agentes
NVIDIA_API_KEY=
NVIDIA_DOCUMENT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_AGENT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Webhook de entrada
UIF_WEBHOOK_HEADER_NAME=X-UIF-Token
UIF_WEBHOOK_HEADER_VALUE=

# Base de observabilidad
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=u432959280_uif
MYSQL_USER=
MYSQL_PASSWORD=

# Alertas operativas
UIF_ALERT_WEBHOOK_URL=

# Parámetros de gobernanza de referencia
MIN_AGENT_CONFIDENCE=0.85
MAX_AGENT_LATENCY_MS=15000
MAX_EXECUTION_COST_USD=0.50

# Tarifas vigentes del proveedor para estimación de costo.
# Mantener en 0 hasta cargar precios verificados.
AI_INPUT_USD_PER_1M=0
AI_OUTPUT_USD_PER_1M=0
